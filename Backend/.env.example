# Example environment variables for Backend
# MongoDB connection string (required in production)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/yourdb

# App port (optional)
PORT=10000

# JWT secret used to sign tokens
JWT_SECRET=replace_with_strong_secret

# Dev admin credentials used only when DB is empty (development)
DEV_ADMIN_EMAIL=admin@cravvio.com
DEV_ADMIN_PASS=admin123

# Frontend origin(s). You can set FRONTEND_URL or a comma-separated ALLOWED_ORIGINS
FRONTEND_URL=https://cravvio-major-project.onrender.com
ALLOWED_ORIGINS=https://cravvio-major-project.onrender.com,https://localhost:5173

# Image upload service (ImageKit) credentials (optional)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
